    "Nest depth 0 (within excrement)": {
     "choice": "measured",
     "probs": {
      "measured": 0.948,
      "literature": 0.052
     },
     "said": [
      "## 3) Nest depth Due to the great variability in nest depth even in species with the same nesting pattern, we differentiated the species based on nest depth into: 0) within excrement, 1) dungsoil interphase, 2) little depth and 3) great depth."
     ],
     "value": "measured"
    },
    "Horizontal nest distance 0 (within food source)": {
