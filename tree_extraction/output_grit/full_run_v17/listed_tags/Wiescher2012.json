    },
    "Mass (mg)": {
     "choice": "measured",
     "probs": {
      "measured": 0.988,
      "literature": 0.012
     },
     "said": [
      "To test for evidence of allometric relationships between ant size (head width, head length, and mass) and leg length, we performed standardized major axis regressions using the smatr package (Warton and Ormerod 2007) in R 2.10.1 (R Development Core Team 2009).",
      "LT values were calculated for each species using probit regression to estimate the temperature at which 99% of individuals succumb to heat stress; probit regression was done using R 2.10.1 (R Development Core Team 2009) and the MASS package (Venables and Ripley 2002)."
     ],
     "value": "measured"
    },
    "HW (mm)": {
     "said": [],
     "value": null
    },
    "HL (mm)": {
