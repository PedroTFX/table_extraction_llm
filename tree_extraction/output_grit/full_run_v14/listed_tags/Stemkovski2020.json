     "said": [],
     "value": null
    },
    "Site variance": {
     "said": [],
     "value": null
    },
    "Species variance": {
     "choice": "measured",
     "probs": {
      "measured": 0.76,
      "literature": 0.24
     },
     "said": [
      "We found that the variance attributed to years and sites was highest for emergence and decreased with later phenophases, while the variance attributed to species was highest for senescence.",
      "The proportion of variance attributed to years and sites decreases across phenophases, while it increases across phenophases for species."
     ],
     "value": null
    },
    "Residual variance": {
     "choice": "measured",
     "probs": {
      "measured": 0.613,
      "literature": 0.387
     },
     "said": [
      "Upon fitting the model, we calculated the proportion of the variance attributed to each random effect by dividing the variance (the square of the standard deviation) by the sum of the variances of the other random effects including the residual variance.",
      "The variance attributed to each random effect and residual variance."
     ],
     "value": null
    }
   }
  },
