  "6": {
   "long": false,
   "traits": {
    "Eye diameter/mm": {
     "choice": "measured",
     "probs": {
      "measured": 0.949,
      "literature": 0.051
     },
     "said": [
      "We quantified the standard linear measurements of head width, eye diameter, the distance between eyes (eye position), femur length of the hind leg and Weber’s length (Table 2, Suppl.",
      "In this study, we focused on total effects of traits of all ant species amongst five habitat types instead of the difference between ant species, so we explored the distribution pattern of ant traits amongst different habitats by the kernel density plot of ant traits, using raw traits data after log(x+1) transformed, then the fourth corner analysis was applied for a fair comparison, based on the residuals of the regression of femur length, eye diameter and eye position on Weber's length, which narrow the difference of traits due to ant species."
     ],
     "value": "measured"
    },
    "Distance between eyes/mm": {
     "choice": "measured",
     "probs": {
      "measured": 0.975,
      "literature": 0.025
     },
     "said": [
      "We quantified the standard linear measurements of head width, eye diameter, the distance between eyes (eye position), femur length of the hind leg and Weber’s length (Table 2, Suppl.",
      "Four ant traits (eye diameter, distance between eyes, femur length of the hind-leg and Weber’s length) were utilised to construct a kernel density plot of ant species trait means amongst different sites to explore how ant traits varied amongst the habitats."
     ],
     "value": "measured"
    },
    "Femur length/mm": {
     "choice": "measured",
     "probs": {
      "measured": 0.865,
      "literature": 0.135
     },
     "said": [
      "We quantified the standard linear measurements of head width, eye diameter, the distance between eyes (eye position), femur length of the hind leg and Weber’s length (Table 2, Suppl.",
      "In this study, we focused on total effects of traits of all ant species amongst five habitat types instead of the difference between ant species, so we explored the distribution pattern of ant traits amongst different habitats by the kernel density plot of ant traits, using raw traits data after log(x+1) transformed, then the fourth corner analysis was applied for a fair comparison, based on the residuals of the regression of femur length, eye diameter and eye position on Weber's length, which narrow the difference of traits due to ant species."
     ],
     "value": "measured"
    },
    "Weber's length/mm": {
     "choice": "measured",
     "probs": {
      "measured": 0.978,
      "literature": 0.022
     },
     "said": [
      "We quantified the standard linear measurements of head width, eye diameter, the distance between eyes (eye position), femur length of the hind leg and Weber’s length (Table 2, Suppl.",
      "Ant Weber’s length data were square-root transformed and the number of individuals of each species in each site was used to multiply the trait value to obtain the total trait value."
     ],
     "value": "measured"
    }
